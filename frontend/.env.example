# Variables opcionales del frontend (Vite). Se aplican al compilar; tras cambiarlas hay que redesplegar.

# URL del backend. Si está vacía, se usa la ruta relativa /api (la reescritura de vercel.json la reenvía al backend).
# VITE_API_URL=

# Resiliencia de las lecturas (GET): reintentos ante 429/502/503/504, máximo de lecturas
# simultáneas y caché en memoria de los catálogos. El valor "false" la desactiva por completo.
# VITE_RESILIENCIA=true
# Máximo de lecturas simultáneas hacia la API (3 por defecto).
# VITE_MAX_PARALELAS=3

# Diagnóstico de fallos de red (activo por defecto): agrega el código HTTP y la ruta a los
# mensajes de error genéricos y guarda los últimos 30 fallos. En la consola del navegador,
# urbancloudDiagnostico() muestra y copia ese historial. El valor "false" lo desactiva.
# VITE_DIAGNOSTICO=true
