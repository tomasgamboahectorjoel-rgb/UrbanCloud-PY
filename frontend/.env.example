# Variables opcionales del frontend (Vite). Se aplican al compilar; tras cambiarlas hay que redesplegar.

# URL del backend. Vacia = usar la ruta relativa /api (el rewrite de vercel.json reenvia al backend).
# VITE_API_URL=

# Resiliencia de las lecturas (GET): reintentos ante 429/502/503/504, maximo de lecturas
# simultaneas y cache en memoria de los catalogos. "false" la desactiva por completo.
# VITE_RESILIENCIA=true
# Maximo de lecturas simultaneas hacia la API (por defecto 3).
# VITE_MAX_PARALELAS=3

# Diagnostico de fallos de red (por defecto activo): agrega el codigo HTTP y la ruta a los
# mensajes de error genericos y guarda los ultimos 30 fallos. En la consola del navegador:
# urbancloudDiagnostico()  muestra y copia ese historial. "false" lo desactiva.
# VITE_DIAGNOSTICO=true
